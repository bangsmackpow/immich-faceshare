IMMICH_URL=http://immich:2283
IMMICH_API_KEY=your-immich-api-key-here
FRONTEND_URL=http://localhost:3001

# Better Auth — random secret for session encryption
BETTER_AUTH_SECRET=change-me-to-a-random-secret
# Better Auth — public URL of your instance (for callbacks/cookies)
BETTER_AUTH_URL=http://localhost:3001

# URL Signing — secret for signing download/asset URLs
SIGNING_SECRET=change-me-to-a-different-random-secret

# Admin account — created on first boot if no users exist
ADMIN_EMAIL=admin@abc.xyz
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Administrator

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@faceshare.local

# Database & storage paths
DATABASE_PATH=/data/faceshare.db
BACKUP_DIR=/data/backups
DOWNLOADS_DIR=/data/downloads

# Logging
LOG_DIR=/data/logs
LOG_LEVEL=info
LOG_TO_FILE=true

# Server
PORT=3001
NODE_ENV=production

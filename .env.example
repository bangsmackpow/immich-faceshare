IMMICH_URL=http://immich:2283
IMMICH_API_KEY=your-immich-api-key-here
FRONTEND_URL=http://localhost:3001

# Better Auth — random secret for session encryption
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# URL Signing — secret for signing download/asset URLs
SESSION_SECRET=change-me-to-a-different-random-secret

# Admin account — created on first boot if no users exist
ADMIN_EMAIL=admin@abc.xyz
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Administrator

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@faceshare.local
DATABASE_PATH=/data/faceshare.db
LOG_DIR=/data/logs
DOWNLOADS_DIR=/data/downloads
PORT=3001
NODE_ENV=production
